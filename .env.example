# Pozzer DePIN Platform - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# WalletConnect Configuration (REQUIRED)
# ============================================
# Get your Project ID: https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# ============================================
# Admin Authentication (REQUIRED)
# ============================================
# Generate a strong random secret (e.g., openssl rand -base64 32)
ADMIN_JWT_SECRET=your_random_jwt_secret_here

# Comma-separated list of authorized admin emails
AUTHORIZED_ADMIN_EMAILS=admin@example.com,admin2@example.com

# ============================================
# Testnet Configuration
# ============================================
# Date when testnet becomes publicly accessible (ISO 8601 format)
# Example: 2025-04-01T00:00:00Z
TESTNET_UNLOCK_DATE=2025-04-01T00:00:00Z

# Password for early access before unlock date
TESTNET_EARLY_ACCESS_PASSWORD=your_secure_password_here

# ============================================
# API Access (OPTIONAL)
# ============================================
# API key for external integrations (if needed)
# Leave empty if not using external API access
API_KEY=

# ============================================
# hCaptcha (OPTIONAL)
# ============================================
# Get keys from: https://www.hcaptcha.com/
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# ============================================
# Optional Internal Services
# ============================================
# Configure only if your deployment uses an external users service
USERS_SERVICE_API_URL=
USERS_SERVICE_API_KEY=
